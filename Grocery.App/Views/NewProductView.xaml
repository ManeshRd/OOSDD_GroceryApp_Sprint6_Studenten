<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Grocery.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="Grocery.App.Views.NewProductView"
             x:DataType="viewmodels:NewProductViewModel">

    <ScrollView>
        <Grid Padding="20"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10">

            <!-- Title -->
            <Label Text="Nieuw Product"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Grid.Row="0"
                   Margin="0,0,0,20"/>

            <!-- Name -->
            <Label Text="Productnaam"
                   FontAttributes="Bold"
                   Grid.Row="1"/>
            <Entry Text="{Binding Name}"
                   Placeholder="Naam"
                   Grid.Row="2"/>

            <!-- Stock -->
            <Label Text="Voorraad"
                   FontAttributes="Bold"
                   Grid.Row="3"/>
            <Entry Text="{Binding Stock}"
                   Keyboard="Numeric"
                   Placeholder="Aantal"
                   Grid.Row="4"/>

            <!-- Price -->
            <Label Text="Prijs (€)"
                   FontAttributes="Bold"
                   Grid.Row="5"/>
            <Entry Text="{Binding Price}"
                   Keyboard="Numeric"
                   Placeholder="0.00"
                   Grid.Row="6"/>

            <!-- Date -->
            <Label Text="Houdbaarheidsdatum"
                   FontAttributes="Bold"
                   Grid.Row="7"/>

            <DatePicker x:Name="ShelfLifePicker"
                        Date="{Binding ShelfLife, Mode=TwoWay}"
                        Format="dd-MM-yyyy"
                        BackgroundColor="AliceBlue"
                        TextColor="Black"
                        Margin="0,0,0,15"
                        Grid.Row="8"/>

            <!-- Save Button -->
            <Button Text="Opslaan"
                    Command="{Binding SaveProductCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HeightRequest="50"
                    Grid.Row="9"
                    Margin="0,20,0,0"/>
        </Grid>
    </ScrollView>

</ContentPage>
